# Copy to .env and adjust. Never commit the real .env file.
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL — set DB_NAME to switch from SQLite to Postgres
DB_ENGINE=django.db.backends.postgresql
DB_NAME=digitalwedding
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# …or a single connection string (takes precedence over the DB_* values above)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/digitalwedding

# Business / support
SUPPORT_WHATSAPP=+910000000000
SUPPORT_EMAIL=hello@digitalwedding.in
DEFAULT_SITE_URL=http://127.0.0.1:8000
